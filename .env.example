# ==============================================================================
# GadgetZone Environment Configuration
# ==============================================================================

# Port configuration (default 5000)
PORT=5000

# JWT Secret for authentication tokens
JWT_SECRET=GadgetZone_super_secret_key_change_in_production

# Database Connection:
# ------------------------------------------------------------------------------
# Option A: Local MongoDB inside Docker (Default, no cloud setup needed)
MONGODB_URI=mongodb://mongodb:27017/GadgetZone

# Option B: MongoDB Atlas Cloud (Uncomment if using Atlas)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/GadgetZone?retryWrites=true&w=majority
