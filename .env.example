# ==============================================================================
# GadgetZone Environment Configuration
# ==============================================================================

# Port configuration (default 5000)
PORT=5000

# JWT Secret for admin/user authentication tokens
JWT_SECRET=GadgetZone_super_secret_key_change_in_production

# Database Connection:
# ------------------------------------------------------------------------------
# Option A: Local MongoDB inside Docker (Default, no cloud Atlas needed)
MONGODB_URI=mongodb://mongodb:27017/GadgetZone

# Option B: MongoDB Atlas Cloud (Uncomment and replace with your credentials)
# MONGODB_URI=mongodb+srv://gadgetzone667_db_user:62yCRXapnIhM8rn8@gzone.jbucsqs.mongodb.net/GadgetZone?retryWrites=true&w=majority&compressors=zlib

